{
  "name": "react-glide-carousel",
  "version": "0.0.12",
  "description": "react smooth carousel with easing parallax effect on sliding ",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tailwindcss --input src/style.css --output dist/index.css --minify && rollup -c",
    "test": "echo 'No test specified'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANJITH-B/react-glide-carousel.git"
  },
  "bugs": {
    "url": "https://github.com/ANJITH-B/react-glide-carousel/issues"
  },
  "keywords": [
    "carousel",
    "slider",
    "image-slider",
    "image-carousel",
    "parallax-slider",
    "react",
    "banner",
    "smooth-slider",
    "react-smooth-slider",
    "react-smooth-carousel",
    "easing-slider",
    "react-glide-carousel",
    "react-glide-slider"
  ],
  "author": "anjith b",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@tailwindcss/cli": "^4.1.18",
    "@types/react": "^18.2.0",
    "rollup": "^4.53.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  }
}
